generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}
enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}
enum Difficulty {
  EASY
  MEDIUM
  HARD
}
enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  SOLVED
}
enum AccessType {
  FREE
  PREMIUM
  SELECTED_USERS
}
enum NoteContentType {
  PDF
  IMAGE
  HTML
  MARKDOWN
  EXTERNAL
}
enum ResourceType {
  TEXT
  PDF
  IMAGE
  VIDEO
  LINK
}
enum InterviewStatus {
  SELECTED
  REJECTED
  PENDING
}
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  MANUAL_REVIEW
}
enum NotificationType {
  INFO
  NEW_CONTENT
  ANNOUNCEMENT
}
enum NotificationTarget {
  ALL_USERS
  SELECTED_USERS
}
enum BookmarkType {
  PROBLEM
  NOTE
  ROADMAP
  CHEATSHEET
  INTERVIEW
}
enum ProtectedType {
  NOTE
  CHEATSHEET
  ROADMAP
  ROADMAP_RESOURCE
  PROBLEM
}
enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}
enum CheatSheetCategory {
  DSA
  JAVA
  SQL
  DBMS
  OS
  CN
  APTITUDE
  GIT_GITHUB
}
enum ActivityType {
  LOGIN
  LOGOUT
  PROBLEM_SOLVED
  PROBLEM_BOOKMARKED
  PROBLEM_FLAGGED
  PROBLEM_REVISED
  NOTE_VIEWED
  ROADMAP_VIEWED
  CHEATSHEET_VIEWED
  INTERVIEW_VIEWED
  PERSONAL_NOTE_CREATED
  STUDY_SESSION
  CONTENT_UNLOCKED
  PAYMENT
  COMMENT
  LIKE
  PRACTICE
  ROADMAP_RESOURCE_COMPLETED
}

model User {
  id                 String     @id @default(cuid())
  name               String
  username           String     @unique
  email              String     @unique
  passwordHash       String?
  avatarUrl          String?
  role               Role       @default(USER)
  status             UserStatus @default(ACTIVE)
  emailVerified      Boolean    @default(false)
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  lastActiveAt       DateTime   @default(now())

  oauthAccounts     OAuthAccount[]
  sessions          Session[]
  tokens            AuthToken[]
  activities        Activity[]
  daily             DailyActivity[]
  progress          UserProblemProgress[]
  bookmarks         Bookmark[]
  entitlements      ContentEntitlement[]
  payments          Payment[]
  roadmapProgress   UserRoadmapProgress[]
  interviewLikes    InterviewLike[]
  interviewComments InterviewComment[]
  interviews        InterviewExperience[]
  notifications     NotificationRecipient[]
  aptitudeAttempts  AptitudeAttempt[]
  corePracticeAttempts CorePracticeAttempt[]
  topicCompletions  TopicCompletion[]
  roadmapNodes      UserRoadmapNode[]

  @@index([lastActiveAt])
  @@index([createdAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  persistent Boolean   @default(true)
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Activity {
  id        String       @id @default(cuid())
  userId    String
  type      ActivityType
  refType   String?
  refId     String?
  date      DateTime     @db.Date
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([type, createdAt])
}

model DailyActivity {
  userId String
  date   DateTime @db.Date
  count  Int      @default(0)
  solved Int      @default(0)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@index([date])
}

model DSASheet {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  totalProblems Int      @default(0)
  isPublished   Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  topics        DSATopic[]
}

model DSATopic {
  id          String   @id @default(cuid())
  sheetId     String
  name        String
  slug        String
  description String?
  hint        String?
  tip         String?
  order       Int      @default(0)
  sheet       DSASheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  subtopics   DSASubtopic[]
  problems    Problem[]

  @@unique([sheetId, slug])
  @@index([sheetId, order])
}

model DSASubtopic {
  id          String   @id @default(cuid())
  topicId     String
  name        String
  slug        String
  description String?
  tip         String?
  order       Int      @default(0)
  topic    DSATopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  problems Problem[]

  @@unique([topicId, slug])
}

model Problem {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  description   String?
  difficulty    Difficulty
  leetcodeUrl   String?
  gfgUrl        String?
  youtubeUrl    String?
  topicId       String
  subtopicId    String?
  pattern       String?
  quickRevision String?
  adminNotes    String?
  imageUrl      String?
  tags          String[]
  hints         String[]
  images        String[]
  isPublished   Boolean      @default(false)
  isPremium     Boolean      @default(false)
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  topic         DSATopic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopic      DSASubtopic? @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  companies     ProblemCompany[]
  progress      UserProblemProgress[]

  @@index([difficulty])
  @@index([topicId])
  @@index([isPublished])
}

model Company {
  id         String  @id @default(cuid())
  name       String
  slug       String  @unique
  logoUrl    String?
  websiteUrl String?
  problems   ProblemCompany[]
  interviews InterviewExperience[]
}

model ProblemCompany {
  problemId String
  companyId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([problemId, companyId])
  @@index([companyId])
}

model UserProblemProgress {
  id                 String         @id @default(cuid())
  userId             String
  problemId          String
  status             ProgressStatus @default(NOT_STARTED)
  solvedAt           DateTime?
  attempts           Int            @default(0)
  wrongAttempts      Int            @default(0)
  usedHint           Boolean        @default(false)
  flaggedForRevision Boolean        @default(false)
  revisedAt          DateTime?
  personalNote       String?
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem            Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, status])
  @@index([userId, flaggedForRevision])
}

model Bookmark {
  id         String       @id @default(cuid())
  userId     String
  targetType BookmarkType
  targetId   String
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

model CoreCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  order       Int     @default(0)
  patterns    CorePattern[]
  topics      CoreTopic[]
}

model CorePattern {
  id         String       @id @default(cuid())
  categoryId String
  name       String
  slug       String
  order      Int          @default(0)
  category   CoreCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  topics     CoreTopic[]

  @@unique([categoryId, slug])
}

model CoreTopic {
  id          String       @id @default(cuid())
  categoryId  String
  patternId   String?
  name        String
  slug        String       @unique
  summary     String?
  order       Int          @default(0)
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  category    CoreCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  pattern     CorePattern? @relation(fields: [patternId], references: [id], onDelete: SetNull)
  contents    CoreContent[]
  questions   CorePracticeQuestion[]

  @@index([categoryId, order])
}

model CorePracticeQuestion {
  id          String                 @id @default(cuid())
  topicId     String
  prompt      String
  options     Json
  correctIndex Int
  explanation String?
  order       Int                    @default(0)
  isPublished Boolean                @default(true)
  topic       CoreTopic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts    CorePracticeAttempt[]

  @@index([topicId, order])
}

model CorePracticeAttempt {
  userId     String
  questionId String
  correct    Boolean
  updatedAt  DateTime              @updatedAt
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   CorePracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([userId])
}

model CoreContent {
  id          String    @id @default(cuid())
  topicId     String
  title       String
  body        String
  order       Int       @default(0)
  isPublished Boolean   @default(true)
  topic       CoreTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, order])
}

model AptitudeCategory {
  id     String @id @default(cuid())
  name   String
  slug   String @unique
  order  Int    @default(0)
  topics AptitudeTopic[]
}

model AptitudeTopic {
  id          String           @id @default(cuid())
  categoryId  String
  name        String
  slug        String           @unique
  notes       String?
  order       Int              @default(0)
  isPublished Boolean          @default(true)
  category    AptitudeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  questions   AptitudeQuestion[]

  @@index([categoryId, order])
}

model AptitudeQuestion {
  id           String        @id @default(cuid())
  topicId      String
  question     String
  options      Json
  correctIndex Int
  explanation  String?
  difficulty   Difficulty    @default(MEDIUM)
  order        Int           @default(0)
  topic        AptitudeTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts     AptitudeAttempt[]

  @@index([topicId, order])
}

model AptitudeAttempt {
  userId     String
  questionId String
  correct    Boolean
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   AptitudeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
}

model Puzzle {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String
  pattern     String?
  difficulty  Difficulty @default(MEDIUM)
  hints       Json       @default("[]")
  solution    String?
  imageUrl    String?
  isPublished Boolean    @default(false)
  isPremium   Boolean    @default(false)
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isPublished, pattern])
}

model Note {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  description     String?
  category        String?
  contentType     NoteContentType
  fileKey         String?
  content         String?
  previewImageUrl String?
  externalUrl     String?
  price           Decimal         @default(0) @db.Decimal(10, 2)
  accessType      AccessType      @default(FREE)
  isPublished     Boolean         @default(false)
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([isPublished, accessType])
  @@index([category])
}

model CheatSheet {
  id              String             @id @default(cuid())
  title           String
  slug            String             @unique
  category        CheatSheetCategory
  description     String?
  content         String?
  fileKey         String?
  previewImageUrl String?
  price           Decimal            @default(0) @db.Decimal(10, 2)
  accessType      AccessType         @default(FREE)
  isPublished     Boolean            @default(false)
  createdBy       String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([category, isPublished])
}

model Certification {
  id          String   @id @default(cuid())
  title       String
  provider    String
  description String?
  url         String
  imageUrl    String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, order])
}

model ContentEntitlement {
  id          String        @id @default(cuid())
  userId      String
  contentType ProtectedType
  contentId   String
  accessType  AccessType    @default(SELECTED_USERS)
  source      String        @default("ADMIN_GRANT")
  grantedBy   String?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, contentId])
  @@index([contentType, contentId])
}

model PendingEntitlement {
  id          String        @id @default(cuid())
  email       String
  contentType ProtectedType
  contentId   String
  grantedBy   String?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())

  @@unique([email, contentType, contentId])
}

model Roadmap {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  imageUrl    String?
  icon        String?
  isPublished Boolean  @default(false)
  isPremium   Boolean  @default(false)
  price       Decimal  @default(0) @db.Decimal(10, 2)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sections    RoadmapSection[]
  progress    UserRoadmapProgress[]
}

model RoadmapSection {
  id          String  @id @default(cuid())
  roadmapId   String
  title       String
  description String?
  icon        String?
  order       Int     @default(0)
  roadmap     Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics      RoadmapTopic[]

  @@index([roadmapId, order])
}

model RoadmapTopic {
  id          String         @id @default(cuid())
  sectionId   String
  title       String
  description String?
  icon        String?
  order       Int            @default(0)
  section     RoadmapSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  resources   RoadmapResource[]

  @@index([sectionId, order])
}

model RoadmapResource {
  id          String       @id @default(cuid())
  topicId     String
  type        ResourceType @default(TEXT)
  title       String
  description String?
  content     String?
  fileKey     String?
  imageUrl    String?
  youtubeUrl  String?
  externalUrl String?
  order       Int          @default(0)
  isPremium   Boolean      @default(false)
  price       Decimal      @default(0) @db.Decimal(10, 2)
  topic       RoadmapTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress    UserRoadmapProgress[]

  @@index([topicId, order])
}

model UserRoadmapProgress {
  id          String          @id @default(cuid())
  userId      String
  roadmapId   String
  resourceId  String
  completed   Boolean         @default(true)
  completedAt DateTime?
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap     Roadmap         @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  resource    RoadmapResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId, roadmapId])
}

model InterviewExperience {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  company         String
  companyId       String?
  role            String
  experienceLevel String?
  difficulty      Difficulty      @default(MEDIUM)
  status          InterviewStatus @default(PENDING)
  roundCount      Int             @default(1)
  summary         String?
  background      String?
  verdict         String?
  tags            String[]
  isAnonymous     Boolean         @default(true)
  isPublished     Boolean         @default(false)
  createdBy       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  author          User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  companyRef      Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  rounds          InterviewRound[]
  comments        InterviewComment[]
  likes           InterviewLike[]

  @@index([isPublished, createdAt])
  @@index([company])
  @@index([status, difficulty])
}

model InterviewRound {
  id           String              @id @default(cuid())
  experienceId String
  roundNumber  Int
  title        String
  description  String?
  experience   InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  questions    InterviewQuestion[]

  @@index([experienceId, roundNumber])
}

model InterviewQuestion {
  id       String         @id @default(cuid())
  roundId  String
  question String
  order    Int            @default(0)
  round    InterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
}

model InterviewComment {
  id           String              @id @default(cuid())
  experienceId String
  userId       String
  body         String
  isDeleted    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  experience   InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([experienceId, createdAt])
}

model InterviewLike {
  experienceId String
  userId       String
  createdAt    DateTime            @default(now())
  experience   InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([experienceId, userId])
}

model Notification {
  id         String             @id @default(cuid())
  title      String
  message    String
  type       NotificationType   @default(INFO)
  targetType NotificationTarget @default(ALL_USERS)
  linkUrl    String?
  createdBy  String?
  expiresAt  DateTime?
  /// null = draft (admin-created, not yet delivered). System notifications are published immediately.
  publishedAt     DateTime? @default(now())
  durationSeconds Int?
  createdAt  DateTime           @default(now())
  recipients NotificationRecipient[]

  @@index([targetType, createdAt])
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  contentType       ProtectedType
  contentId         String
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  provider          String
  providerPaymentId String?
  paymentUrl        String?
  proofReference    String?
  reviewNote        String?
  reviewedBy        String?
  createdAt         DateTime      @default(now())
  verifiedAt        DateTime?
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([userId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  message   String
  page      String?
  createdAt DateTime @default(now())
}

model Testimonial {
  id          String  @id @default(cuid())
  name        String
  handle      String?
  location    String?
  message     String
  rating      Int     @default(5)
  avatarUrl   String?
  isPublished Boolean @default(false)
  order       Int     @default(0)
}

/// Landing-page "Courses" showcase. Marketing listing only: enrolment happens at ctaUrl, not through in-app payments.
model Course {
  id            String   @id @default(cuid())
  title         String
  description   String
  thumbnailUrl  String?
  level         String?
  duration      String?
  priceLabel    String?
  highlights    Json     @default("[]")
  ctaLabel      String?
  ctaUrl        String?
  isPublished   Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isPublished, order])
}

/// Key/value site configuration (founder section, admin settings).
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A learner marking a Core CS / Aptitude topic as read.
model TopicCompletion {
  userId    String
  kind      String   // 'core' | 'aptitude'
  topicId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, kind, topicId])
}

/// Completion of a roadmap section or topic (nodes in the roadmap tree). Resource-level progress lives in UserRoadmapProgress.
model UserRoadmapNode {
  userId      String
  roadmapId   String
  nodeId      String
  completed   Boolean  @default(true)
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, nodeId])
  @@index([userId, roadmapId])
}
