NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/risingbrain?schema=public
PORT=4000
# Comma-separated list allowed for CORS / CSRF origin check (no trailing slash)
FRONTEND_URL=http://localhost:3000,http://localhost:3001
# Public URL of this API (used in secure file URLs and OAuth defaults)
API_URL=http://localhost:4000
RENDER_EXTERNAL_URL=
# Set to your parent domain (e.g. .example.com) when frontend/api share a parent domain
COOKIE_DOMAIN=
# lax | none | strict  (default: none in production, lax otherwise)
COOKIE_SAMESITE=
# Number of reverse proxies in front of the API (Render = 1; Render behind the Vercel same-origin rewrite = 2)
TRUST_PROXY_HOPS=1
APP_TIMEZONE=Asia/Kolkata

SESSION_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-64-char-random-string-change-me-to-a-64-char-random

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud Console > Credentials > OAuth client (Web). Authorized redirect URI must equal this value exactly.
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub > Settings > Developer settings > OAuth Apps. Authorization callback URL must equal this value.
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="CodeWithAws <no-reply@example.com>"

# S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO, Supabase...)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_ENDPOINT=

# PAYMENT_PROVIDER = UPI_MANUAL (manual review) | RAZORPAY (automatic, webhook-verified)
PAYMENT_PROVIDER=UPI_MANUAL
PAYMENT_KEY_ID=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
UPI_PAYMENT_URL=upi://pay?pa=yourid@bank&pn=CodeWithAws

# First-run admin (created only if no ADMIN exists). Password change is forced on first login.
ADMIN_EMAIL=
ADMIN_NAME=Admin
ADMIN_INITIAL_PASSWORD=
# Optional one-shot recovery: set this temporarily, run `npm run admin:reset-password`, then remove it.
ADMIN_RESET_PASSWORD=
